# Supabase project (Project Settings → API). Without these the app runs in demo mode only.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Legacy projects can use the anon key instead:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Ask Plumb (AI assistant). Server-side only, never prefix with NEXT_PUBLIC_.
# Create the key on platform.openai.com (API billing is separate from a ChatGPT subscription).
OPENAI_API_KEY=sk-...
# Optional, defaults to gpt-4o-mini
# OPENAI_MODEL=gpt-4o-mini
